{
  "name": "chat-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prestart": "cd ../code && pip install -r requirements-api.txt -q",
    "start": "concurrently -k \"npm run start:api\" \"npm run start:web\"",
    "start:api": "cd ../code && cross-env PYTHONUTF8=1 python -X utf8 api_server.py",
    "start:web": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-scripts": "5.0.0",
    "typescript": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
